{
  "name": "hard-mode",
  "version": "0.1.1",
  "description": "Local browser runner and agent skill that exercise a web app under repeatable UI stress scenarios and produce visual evidence.",
  "license": "MIT",
  "type": "module",
  "files": [
    ".claude-plugin",
    "dist",
    "skills",
    "fixtures",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "hard-mode": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && playwright test",
    "test:unit": "playwright test --project unit",
    "test:e2e": "npm run build && playwright test --project e2e",
    "demo": "node scripts/demo.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^24.19.1",
    "axe-core": "^4.14.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "playwright",
    "testing",
    "e2e",
    "ui",
    "accessibility",
    "chaos",
    "agent-skills"
  ],
  "publishConfig": {
    "access": "public"
  }
}
